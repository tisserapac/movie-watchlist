@@ -0,0 +1,16 @@
+import { useState } from 'react';
+
+// Keeps the current filter ('all', 'todo' or 'watched') and returns
+// the movies that match it.
+function useMovieFilter(movies) {
+  const [filter, setFilter] = useState('all');
+
+  // calculated, NOT stored in state
+  const visibleMovies = movies.filter(
+    (m) => filter === 'all' || (filter === 'watched') === m.watched
+  );
+
+  return { filter, setFilter, visibleMovies };
+}
+
+export default useMovieFilter;
