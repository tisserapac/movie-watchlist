# Based on the .gitignore that `npm create vite@latest` generates.
# A leading "/" matches only at the repository root: a bare name like
# "context/" would also hide folders such as src/context/.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output and test coverage
/dist
/dist-ssr
/coverage

# Environment files (keep secrets out of git; .env.example may be committed)
.env
.env.*
!.env.example
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Lecture materials (not part of the app)
/context/
